# Copy to .env.local for local dev, and set these in your host's
# environment variables panel when deploying.

# Google AI Studio → https://aistudio.google.com/apikey
# Server-side only. Never prefix this with NEXT_PUBLIC_ — that would ship
# the key to the browser where anyone can read it.
GEMINI_API_KEY=

# Supabase → Project Settings → API
# Both are NEXT_PUBLIC_ because the browser talks to Supabase directly.
# The anon key is meant to be public; your Row Level Security policies are
# what actually protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role key
# Server-side only, and far more powerful than the anon key: it bypasses
# every RLS policy. Used solely by /api/admin/* to create and delete users.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
